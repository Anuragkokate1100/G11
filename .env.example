# Copy values into your shell/service environment. Spring Boot does not load .env automatically.
DATABASE_URL=jdbc:mysql://localhost:3306/trackbill_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DATABASE_USERNAME=trackbill_app
DATABASE_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
SERVER_PORT=8080
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Weather uses Open-Meteo and does not require a key.
